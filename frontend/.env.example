# Frontend environment variables.
#
# Copy this file to "frontend/.env" and fill in the real values.
# frontend/.env is gitignored; this file is the public template.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# CARTO public basemap key (used by the Dashboard MapPanel to remove the
# "API KEY REQUIRED" watermark from CARTO raster tiles). The key is a
# public client-side token by CARTO's design and is safe to inline into
# the browser. Obtain a key from https://carto.com/developers/basemaps.
# Leave empty in dev / CI to use the keyless fallback (watermark visible).
VITE_CARTO_BASEMAPS_KEY=
