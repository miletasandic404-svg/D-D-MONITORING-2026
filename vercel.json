{
    "installCommand":  "npm install \u0026\u0026 cd frontend \u0026\u0026 npm install",
    "buildCommand":  "cd frontend \u0026\u0026 npm run build",
    "outputDirectory":  "frontend/dist",
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "index, follow"
                                        },
                                        {
                                            "key":  "Cross-Origin-Opener-Policy",
                                            "value":  "same-origin-allow-popups"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), geolocation=(), microphone=(self)"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027 https://www.paypal.com https://www.paypalobjects.com https://js.stripe.com https://vercel.live https://static.cloudflareinsights.com; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com https://vercel.live data:; img-src \u0027self\u0027 data: https:; media-src \u0027self\u0027 blob: https://*.fly.dev https://*.railway.app; connect-src \u0027self\u0027 https://*.fly.dev https://*.railway.app https://api.paypal.com https://api-m.paypal.com https://api-m.sandbox.paypal.com https://www.paypal.com https://api.stripe.com https://r.stripe.com https://js.stripe.com https://vercel.live https://*.pusher.com wss://*.pusher.com https://*.sentry.io https://*.ingest.sentry.io https://hls.dnd-monitoring.com; frame-src https://www.paypal.com https://www.sandbox.paypal.com https://js.stripe.com https://hooks.stripe.com https://vercel.live; worker-src \u0027self\u0027 blob:; object-src \u0027none\u0027;"
                                        },
                                        {
                                            "key":  "Access-Control-Allow-Origin",
                                            "value":  "https://www.dnd-monitoring.com"
                                        },
                                        {
                                            "key":  "Access-Control-Allow-Methods",
                                            "value":  "GET, POST, PATCH, DELETE, OPTIONS"
                                        },
                                        {
                                            "key":  "Access-Control-Allow-Headers",
                                            "value":  "Content-Type, Authorization"
                                        }
                                    ]
                    }
                ],
    "crons":  [
                  {
                      "path":  "/api/cron-pending-activations",
                      "schedule":  "0 3 * * *"
                  },
                  {
                      "path":  "/api/cron-retention",
                      "schedule":  "0 4 * * *"
                  }
              ],
    "rewrites":  [
                     {
                         "source":  "/api/auth/:path*",
                         "destination":  "/api/auth-all"
                     },
                      {
                          "source": "/api/cron-retention",
                          "destination": "/api/meta?handler=cron-retention"
                      },
                      {
                          "source": "/api/verify-stream-token",
                          "destination": "/api/meta?handler=verify-stream-token"
                      },
                      {
                          "source": "/api/cron-pending-activations",
                          "destination": "/api/meta?handler=cron-pending-activations"
                      },
{
                          "source":  "/api/health/:path*",
                          "destination":  "/api/meta"
                      },
                     {
                         "source":  "/api/ai-detections",
                         "destination":  "/api/resources"
                     },
                     {
                         "source":  "/api/snapshots",
                         "destination":  "/api/resources"
                     },
                     {
                         "source":  "/api/recordings",
                         "destination":  "/api/resources"
                     },
                     {
                         "source":  "/robots.txt",
                         "destination":  "/robots.txt"
                     },
                     {
                         "source":  "/sitemap.xml",
                         "destination":  "/sitemap.xml"
                     },
                     {
                         "source":  "/llms.txt",
                         "destination":  "/llms.txt"
                     },
                     {
                         "source":  "/api/incidents/:eventId/activity",
                         "destination":  "/api/incidents/:eventId?path=activity"
                     },
                     {
                         "source":  "/api/incidents/:eventId/status",
                         "destination":  "/api/incidents/:eventId?path=status"
                     },
                      {
                          "source":  "/api/incidents/:eventId/evidence",
                          "destination":  "/api/incidents/:eventId?path=evidence"
                      },
{
                           "source":  "/api/face-recognition",
                           "destination":  "/api/known-entities?entity=face"
                       },
                       {
                           "source":  "/api/face-recognition/enroll",
                           "destination":  "/api/known-entities?entity=face"
                       },
                       {
                           "source":  "/api/face-recognition/:id",
                           "destination":  "/api/known-entities?entity=face&id=:id"
                       },
                       {
                           "source":  "/api/license-plates",
                           "destination":  "/api/known-entities?entity=plate"
                       },
                       {
                           "source":  "/api/license-plates/enroll",
                           "destination":  "/api/known-entities?entity=plate"
                       },
                       {
                           "source":  "/api/license-plates/:id",
                           "destination":  "/api/known-entities?entity=plate&id=:id"
                       },
                       {
                           "source":  "/api/emergency/dispatch",
                           "destination":  "/api/incidents?path=emergency"
                       },
                       {
                           "source":  "/api/reports/summary",
                           "destination":  "/api/incidents?path=reports"
                       },
                       {
                           "source":  "/api/settings",
                           "destination":  "/api/users?path=settings"
                       },
                       {
                          "source":  "/api/sites",
                          "destination":  "/api/cameras?path=sites"
                      },
                     {
                         "source":  "/api/onboarding/register",
                         "destination":  "/api/onboarding?path=register"
                     },
                     {
                         "source":  "/api/onboarding/connect-camera",
                         "destination":  "/api/onboarding?path=connect-camera"
                     },
                     {
                         "source":  "/api/onboarding/status",
                         "destination":  "/api/onboarding?path=status"
                     },
                     {
                         "source":  "/api/onboarding/complete",
                         "destination":  "/api/onboarding?path=complete"
                     },
                     {
                         "source":  "/api/camera-setup",
                         "destination":  "/api/cameras?path=setup-create"
                     },
                     {
                         "source":  "/api/camera-setup/tasks",
                         "destination":  "/api/cameras?path=setup-list"
                     },
                     {
                         "source":  "/api/camera-setup/node",
                         "destination":  "/api/cameras?path=setup-node"
                     },
                     {
                         "source":  "/api/camera-setup/cancel",
                         "destination":  "/api/cameras?path=setup-cancel"
                     },
                     {
                         "source":  "/api/camera-setup/:id",
                         "destination":  "/api/cameras?path=setup-get\u0026id=:id"
                     },
                     {
                         "source":  "/api/cameras/discover",
                         "destination":  "/api/cameras?path=discover"
                     },
                     {
                         "source":  "/api/cameras/auto-register",
                         "destination":  "/api/cameras?path=auto-register"
                     },
                     {
                         "source":  "/api/cameras/subnet-scan",
                         "destination":  "/api/cameras?path=subnet-scan"
                     },
                     {
                         "source":  "/api/cameras/scan",
                         "destination":  "/api/cameras?path=scan"
                     },
                     {
                         "source":  "/api/operator-assignments",
                         "destination":  "/api/users?path=assignments"
                     },
                     {
                         "source":  "/api/operators",
                         "destination":  "/api/users?path=operators"
                     },
                     {
                         "source":  "/api/audit-logs",
                         "destination":  "/api/users?path=audit-logs"
                     },
                     {
                         "source":  "/api/camera-views/:viewId",
                         "destination":  "/api/camera-views?id=:viewId"
                     },
                     {
                         "source":  "/api/media-nodes/:nodeId/heartbeat",
                         "destination":  "/api/media-nodes?nodeId=:nodeId"
                     },
                     {
                         "source":  "/api/paypal/orders",
                         "destination":  "/api/payments?provider=paypal"
                     },
                     {
                         "source":  "/api/paypal/orders/:orderId/capture",
                         "destination":  "/api/payments?provider=paypal\u0026orderId=:orderId"
                     },
                     {
                         "source":  "/api/paypal/webhook",
                         "destination":  "/api/payments?provider=paypal\u0026path=webhook"
                     },
                     {
                         "source":  "/api/payments/card/intent",
                         "destination":  "/api/payments?provider=card\u0026path=intent"
                     },
                     {
                         "source":  "/api/payments/card/confirm",
                         "destination":  "/api/payments?provider=card\u0026path=confirm"
                     },
                     {
                         "source":  "/api/payments/catalog",
                         "destination":  "/api/payments?path=catalog"
                     },
                     {
                         "source":  "/api/payments/status",
                         "destination":  "/api/payments?path=status"
                     },
                     {
                         "source":  "/api/payments/retry",
                         "destination":  "/api/payments?path=retry"
                     },
                     {
                         "source":  "/api/payments/stripe/webhook",
                         "destination":  "/api/payments?provider=card\u0026path=webhook"
                     },
                     {
                         "source":  "/api/hls/:camera/index.m3u8",
                         "destination":  "/api/hls/:camera"
                     },
                     {
                         "source":  "/((?!api/).*)",
                         "destination":  "/index.html"
                     },
                     {
                          "source":  "/api/cameras/verify-stream-token",
                          "destination":  "/api/meta?handler=verify-stream-token"
                     }
                 ]
}
