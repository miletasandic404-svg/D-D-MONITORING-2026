# D&D Monitoring — Laptop media node env (template)
# Kopiraj u C:\dnd-media\.env ili popuni direktno u start-laptop.bat

# Neon connection string (ISTI kao na Vercelu — owner rola, RLS bypass radi)
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# Iz registracije media node-a (korak 3 u laptop/README.md)
MEDIA_NODE_ID=<node-uuid>
MEDIA_NODE_HEARTBEAT_SECRET=<tajni-secret>

# Heartbeat endpoint
API_BASE_URL=https://www.dnd-monitoring.com/api

# Worker
CAMERA_SYNC_INTERVAL_SECONDS=60
MEDIAMTX_API_URL=http://127.0.0.1:9997
# MEDIAMTX_API_USER=           # samo ako ukljucis basic auth na 9997
# MEDIAMTX_API_PASS=

# ── Camera Setup Wizard V3: Cloudflare Tunnel (opciono) ──
# Potrebno za "Start Tunnel" dugme u wizardu. Prvo: cloudflared tunnel login,
# pa cloudflared tunnel create dnd-hls i cloudflared tunnel route dns dnd-hls hls.dnd-monitoring.com
CLOUDFLARE_TUNNEL_NAME=
# CLOUDFLARE_TUNNEL_CONFIG=C:\dnd-media\cloudflared\config.yml
